include ../../shared/components/Carousel/Carousel.pug
include ../../shared/components/TextButton/TextButton.pug

mixin getAgeSuffix(username, age)
  - const lastDigit = age % 10;
  - const lastTwoDigits = age % 100;
  - let suffix = 'лет';
  - if (lastTwoDigits >= 11 && lastTwoDigits <= 19) {
    - suffix = 'лет';
  - } else {
    - switch (lastDigit) {
      - case 1:
        - suffix = 'год';
        - break;
      - case 2:
      - case 3:
      - case 4:
        - suffix = 'года';
        - break;
      - default:
        - suffix = 'лет';
    - }
  - }
  = ` ${username}, ${age} ${suffix}`

mixin matchCard(user)
  .match-card
    .image-section.match-card__image-section
      if (user.images != null && user.images.length > 0)
        +carousel(user.images)
      else
        img(class="img image-section__img_static" src="/img/image.svg" alt="Image" draggable="false")
    +textButton('Перейти в чат', 'match-card__button')
    if (user.profile.first_name == null || user.profile.first_name == '-')
      h3.match-card__title !{+getAgeSuffix(user.username, user.profile.age)}
    else 
      h3.match-card__title !{+getAgeSuffix(user.profile.first_name, user.profile.age)}